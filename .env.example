# ==============================================
# Annadaata AI (Surplus Food Matcher) - Environment Variables
# ==============================================

# Google Gemini API Key (Optional: for cloud LLM multimodal parsing)
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform API Key (Optional: for custom Map Tiles / Distance Matrix)
# Get your key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Port Configuration (Defaults to 3000)
PORT=3000
